rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'admin@medimap.app',
          'chizomw@gmail.com'
        ]
      );
    }

    function isApprovedHospitalUpdate() {
      return resource.data.approved == true;
    }

    match /hospital_updates/{updateId} {
      allow read: if isAdmin() || isApprovedHospitalUpdate();
      allow create, update, delete: if isAdmin();
    }

    match /facility_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
